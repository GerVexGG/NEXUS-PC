{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nexus",
  "version": "0.1.0",
  "identifier": "com.gervex.nexus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
        {
        "label": "main",
        "title": "NEXUS PC",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "tray_hud",
        "title": "NEXUS PC",
        "url": "index.html?view=tray",
        "width": 280,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "nexus-hwmon.exe"
    ]
  }
}
