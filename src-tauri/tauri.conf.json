{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURORA",
  "version": "2.0.0",
  "identifier": "com.gervex.aurora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AURORA",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#090e1c",
        "shadow": true,
        "visible": false
      },
      {
        "label": "tray_hud",
        "title": "AURORA",
        "url": "index.html?view=tray",
        "width": 280,
        "height": 180,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#090e1c",
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 ws://127.0.0.1:1421; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Gervex",
    "shortDescription": "AURORA Windows System Suite",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "nexus-hwmon.exe": "aurora-hwmon.exe" }
  }
}
